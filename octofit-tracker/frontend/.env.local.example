# Frontend Environment Variables
# Copy this file to .env.local and fill in the values for your environment

# Required for GitHub Codespaces deployment
# Get this value from your codespace name (e.g., "user-repo-abc123")
VITE_CODESPACE_NAME=your-codespace-name

# For local development, leave this commented out and the app will use http://localhost:8000
# VITE_CODESPACE_NAME=
